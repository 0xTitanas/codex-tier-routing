{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xTitanas/codex-tier-routing/schemas/local-dispatch-receipt.schema.json",
  "title": "Codex Tier Routing Local Dispatch Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "mechanism",
    "claim_class",
    "route_requested",
    "route_resolved",
    "policy_kind",
    "policy_id",
    "policy_sha256",
    "policy_input_sha256",
    "policy_document",
    "requested",
    "dispatcher_launcher",
    "dispatcher_launcher_sha256",
    "dispatcher_runtime",
    "dispatcher_runtime_sha256",
    "dispatcher_python",
    "dispatcher_python_sha256",
    "codex_executable",
    "codex_executable_sha256",
    "codex_runtime",
    "codex_runtime_sha256",
    "codex_launch_method",
    "observed",
    "status",
    "started_at",
    "finished_at",
    "output_sha256",
    "rollout_sha256",
    "error"
  ],
  "properties": {
    "schema": {"const": "codex-tier-routing/local-dispatch-receipt/v2"},
    "receipt_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "mechanism": {"const": "codex-exec-local"},
    "claim_class": {"const": "dispatcher_configured_and_host_observed"},
    "route_requested": {"enum": ["scout", "grunt", "builder", "reviewer", "architect"]},
    "route_resolved": {"enum": ["scout", "grunt", "builder", "reviewer", "architect"]},
    "policy_kind": {"enum": ["builtin", "custom"]},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "policy_input_sha256": {"$ref": "#/$defs/sha256"},
    "policy_document": {"$ref": "#/$defs/policyDocument"},
    "requested": {"$ref": "#/$defs/routeObservation"},
    "dispatcher_launcher": {"type": "string", "minLength": 1},
    "dispatcher_launcher_sha256": {"$ref": "#/$defs/sha256"},
    "dispatcher_runtime": {"type": "string", "minLength": 1},
    "dispatcher_runtime_sha256": {"$ref": "#/$defs/sha256"},
    "dispatcher_python": {"type": "string", "minLength": 1},
    "dispatcher_python_sha256": {"$ref": "#/$defs/sha256"},
    "codex_executable": {"type": "string", "minLength": 1},
    "codex_executable_sha256": {"$ref": "#/$defs/sha256"},
    "codex_runtime": {"type": "string", "minLength": 1},
    "codex_runtime_sha256": {"$ref": "#/$defs/sha256"},
    "codex_launch_method": {"enum": ["native", "explicit-shebang-runtime"]},
    "observed": {
      "oneOf": [
        {"$ref": "#/$defs/hostObservation"},
        {"type": "null"}
      ]
    },
    "status": {"enum": ["pass", "halt"]},
    "started_at": {"type": "string", "pattern": "^(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]00|[13579][26]00))-02-29))[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
    "finished_at": {"type": "string", "pattern": "^(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]00|[13579][26]00))-02-29))[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
    "output_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "rollout_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "error": {"type": ["string", "null"]}
  },
  "oneOf": [
    {
      "properties": {
        "route_requested": {"const": "scout"},
        "route_resolved": {"const": "scout"},
        "requested": {"properties": {"sandbox": {"const": "read-only"}}},
        "observed": {"properties": {"sandbox": {"const": "read-only"}}}
      }
    },
    {
      "properties": {
        "route_requested": {"const": "grunt"},
        "route_resolved": {"const": "grunt"},
        "requested": {"properties": {"sandbox": {"const": "workspace-write"}}},
        "observed": {"properties": {"sandbox": {"const": "workspace-write"}}}
      }
    },
    {
      "properties": {
        "route_requested": {"const": "builder"},
        "route_resolved": {"const": "builder"},
        "requested": {"properties": {"sandbox": {"const": "workspace-write"}}},
        "observed": {"properties": {"sandbox": {"const": "workspace-write"}}}
      }
    },
    {
      "properties": {
        "route_requested": {"const": "reviewer"},
        "route_resolved": {"const": "reviewer"},
        "requested": {"properties": {"sandbox": {"const": "read-only"}}},
        "observed": {"properties": {"sandbox": {"const": "read-only"}}}
      }
    },
    {
      "properties": {
        "route_requested": {"const": "architect"},
        "route_resolved": {"const": "architect"},
        "requested": {"properties": {"sandbox": {"const": "read-only"}}},
        "observed": {"properties": {"sandbox": {"const": "read-only"}}}
      }
    }
  ],
  "allOf": [
    {
      "if": {"required": ["policy_kind"], "properties": {"policy_kind": {"const": "builtin"}}},
      "then": {"properties": {"policy_id": {"const": "default-v1"}}}
    },
    {
      "if": {"required": ["policy_kind"], "properties": {"policy_kind": {"const": "custom"}}},
      "then": {"properties": {"policy_id": {"const": "custom-v1"}}}
    },
    {
      "if": {"required": ["status"], "properties": {"status": {"const": "pass"}}},
      "then": {
        "properties": {
          "observed": {"$ref": "#/$defs/hostObservation"},
          "output_sha256": {"$ref": "#/$defs/sha256"},
          "rollout_sha256": {"$ref": "#/$defs/sha256"},
          "error": {"type": "null"}
        }
      }
    },
    {
      "if": {"required": ["status"], "properties": {"status": {"const": "halt"}}},
      "then": {
        "properties": {
          "output_sha256": {"type": "null"},
          "rollout_sha256": {"type": "null"},
          "error": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policyRouteReadOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort", "sandbox", "approval_policy"],
      "properties": {
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "effort": {"enum": ["none", "low", "medium", "high", "xhigh", "max"]},
        "sandbox": {"const": "read-only"},
        "approval_policy": {"const": "never"}
      }
    },
    "policyRouteWorkspaceWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort", "sandbox", "approval_policy"],
      "properties": {
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "effort": {"enum": ["none", "low", "medium", "high", "xhigh", "max"]},
        "sandbox": {"const": "workspace-write"},
        "approval_policy": {"const": "never"}
      }
    },
    "policyDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "policy_id", "routes"],
      "properties": {
        "schema": {"const": "codex-tier-routing/policy/v1"},
        "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scout", "grunt", "builder", "reviewer", "architect"],
          "properties": {
            "scout": {"$ref": "#/$defs/policyRouteReadOnly"},
            "grunt": {"$ref": "#/$defs/policyRouteWorkspaceWrite"},
            "builder": {"$ref": "#/$defs/policyRouteWorkspaceWrite"},
            "reviewer": {"$ref": "#/$defs/policyRouteReadOnly"},
            "architect": {"$ref": "#/$defs/policyRouteReadOnly"}
          }
        }
      }
    },
    "routeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort", "sandbox", "approval_policy", "cwd"],
      "properties": {
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "effort": {"enum": ["none", "low", "medium", "high", "xhigh", "max"]},
        "sandbox": {"enum": ["read-only", "workspace-write"]},
        "approval_policy": {"const": "never"},
        "cwd": {"type": "string", "minLength": 1}
      }
    },
    "hostObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id", "source", "originator", "model_provider", "model",
        "effort", "sandbox", "sandbox_policy", "approval_policy", "cwd", "session_cwd", "cli_version"
      ],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "source": {"const": "exec"},
        "originator": {"const": "codex_exec"},
        "model_provider": {"const": "openai"},
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "effort": {"enum": ["none", "low", "medium", "high", "xhigh", "max"]},
        "sandbox": {"enum": ["read-only", "workspace-write"]},
        "sandbox_policy": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {"type": {"const": "read-only"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "writable_roots", "network_access", "exclude_slash_tmp", "exclude_tmpdir_env_var"],
              "properties": {
                "type": {"const": "workspace-write"},
                "writable_roots": {"type": "array", "maxItems": 0},
                "network_access": {"const": false},
                "exclude_slash_tmp": {"type": "boolean"},
                "exclude_tmpdir_env_var": {"type": "boolean"}
              }
            }
          ]
        },
        "approval_policy": {"const": "never"},
        "cwd": {"type": "string", "minLength": 1},
        "session_cwd": {"type": "string", "minLength": 1},
        "cli_version": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"required": ["sandbox"], "properties": {"sandbox": {"const": "read-only"}}},
          "then": {
            "properties": {
              "sandbox_policy": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {"type": {"const": "read-only"}}
              }
            }
          }
        },
        {
          "if": {"required": ["sandbox"], "properties": {"sandbox": {"const": "workspace-write"}}},
          "then": {
            "properties": {
              "sandbox_policy": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "writable_roots", "network_access", "exclude_slash_tmp", "exclude_tmpdir_env_var"],
                "properties": {
                  "type": {"const": "workspace-write"},
                  "writable_roots": {"type": "array", "maxItems": 0},
                  "network_access": {"const": false},
                  "exclude_slash_tmp": {"type": "boolean"},
                  "exclude_tmpdir_env_var": {"type": "boolean"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
